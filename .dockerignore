# Only inputs used by the release build may enter the Docker context.
**
!package.json
!package-lock.json
!tsconfig.base.json
!apps/
!apps/mcp-server/
apps/mcp-server/**
!apps/mcp-server/package.json
!apps/mcp-server/tsconfig.json
!apps/mcp-server/src/
apps/mcp-server/src/**
!apps/mcp-server/src/**/*.ts
!packages/
!packages/*/
packages/*/**
!packages/*/package.json
!packages/domain/tsconfig.json
!packages/domain/src/
packages/domain/src/**
!packages/domain/src/**/*.ts
!packages/application/tsconfig.json
!packages/application/src/
packages/application/src/**
!packages/application/src/**/*.ts
!packages/database/tsconfig.json
!packages/database/src/
packages/database/src/**
!packages/database/src/**/*.ts
!packages/database/migrations/
packages/database/migrations/**
!packages/database/migrations/*.sql
!packages/database/migrations/meta/
packages/database/migrations/meta/**
!packages/database/migrations/meta/*.json
!packages/infrastructure/tsconfig.json
!packages/infrastructure/src/
packages/infrastructure/src/**
!packages/infrastructure/src/**/*.ts
!packages/mcp/tsconfig.json
!packages/mcp/src/
packages/mcp/src/**
!packages/mcp/src/**/*.ts

# Defense in depth inside allowlisted directories.
**/.env*
**/.git
**/.npmrc
**/node_modules
**/dist
**/coverage
**/*.test.ts
**/*.log
**/*.key
**/*.pem
**/*.crt
**/*.p12
**/*.pfx
