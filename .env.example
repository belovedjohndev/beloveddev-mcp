NODE_ENV=development
LOG_LEVEL=info

# Local development only. Keep this password and DATABASE_URL in sync.
POSTGRES_USER=beloveddev
POSTGRES_PASSWORD=beloveddev_local_only
POSTGRES_DB=beloveddev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://beloveddev:beloveddev_local_only@127.0.0.1:5432/beloveddev

# Dedicated local/CI admin endpoint for disposable integration databases.
# Update this URL together with DATABASE_URL when changing the host port.
TEST_DATABASE_URL=postgresql://beloveddev:beloveddev_local_only@127.0.0.1:5432/beloveddev

# Explicit local stdio identity mode; rejected when NODE_ENV=production.
MCP_AUTH_MODE=local
# Set both to existing active records. Leaving both unset makes tool calls unauthenticated.
# MCP_LOCAL_TENANT_ID=
# MCP_LOCAL_USER_ID=
# Generate a private key: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))"
# MCP_CURSOR_SECRET=
