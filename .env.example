NODE_ENV=development
LOG_LEVEL=info

# Administrator configuration for local Compose, migrations and disposable tests.
# M8-D rejects these superuser credentials for MCP startup. Provision a restricted
# runtime role (docs/database.md) and inject only its URL and MCP/log settings
# into the server's separate protected env file; omit admin/test credentials.
# Keep this password and the administrative URLs in sync.
POSTGRES_USER=beloveddev
POSTGRES_PASSWORD=beloveddev_local_only
POSTGRES_DB=beloveddev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://beloveddev:beloveddev_local_only@127.0.0.1:5432/beloveddev
# Migration CLI only; never falls back to DATABASE_URL or TEST_DATABASE_URL.
DATABASE_MIGRATION_URL=postgresql://beloveddev:beloveddev_local_only@127.0.0.1:5432/beloveddev
# DATABASE_MIGRATION_TLS_CA=
# Administrative-only positive integer milliseconds (maximum 3600000 each).
# DATABASE_MIGRATION_CONNECT_TIMEOUT_MS=5000
# DATABASE_MIGRATION_ADVISORY_LOCK_TIMEOUT_MS=10000
# DATABASE_MIGRATION_LOCK_TIMEOUT_MS=5000
# DATABASE_MIGRATION_STATEMENT_TIMEOUT_MS=120000
# DATABASE_MIGRATION_OPERATION_TIMEOUT_MS=300000
# Recovery administration: configure explicitly in a separate protected env file.
# No runtime, test, or migration URL/CA fallback. Omit from MCP launchers.
# DATABASE_BACKUP_URL=
# DATABASE_BACKUP_TLS_CA=
# DATABASE_RESTORE_ADMIN_URL=
# DATABASE_RESTORE_TLS_CA=
# Absolute PostgreSQL 18 client binary directory; omitted means trusted PATH.
# DATABASE_RECOVERY_PG_BIN=
# DATABASE_RECOVERY_TIMEOUT_MS=300000
# Remote endpoints require ?sslmode=verify-full (loopback-only plaintext above).
# Optional private CA PEM contents; quote multi-line values in the protected env file.
# DATABASE_TLS_CA=

# Dedicated local/CI admin endpoint for disposable integration databases.
# Update all URLs when changing the host port.
TEST_DATABASE_URL=postgresql://beloveddev:beloveddev_local_only@127.0.0.1:5432/beloveddev

# Explicit local stdio identity mode; rejected when NODE_ENV=production.
MCP_AUTH_MODE=local
# Set both to existing active records. Leaving both unset makes tool calls unauthenticated.
# MCP_LOCAL_TENANT_ID=
# MCP_LOCAL_USER_ID=
# Generate a private key: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))"
# Required at startup: placeholders, whitespace/control characters, low diversity,
# and repeated short patterns fail validation. Use a CSPRNG and protect this key.
# Rotation invalidates existing cursors; tests are not a source of operator keys.
# MCP_CURSOR_SECRET=
