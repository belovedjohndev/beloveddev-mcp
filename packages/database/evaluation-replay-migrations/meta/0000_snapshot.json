          "value": "\"evaluation_replay\".\"invocations\".\"expires_at\" > \"evaluation_replay\".\"invocations\".\"issued_at\" AND \"evaluation_replay\".\"invocations\".\"expires_at\" <= \"evaluation_replay\".\"invocations\".\"issued_at\" + interval '15 minutes' AND \"evaluation_replay\".\"invocations\".\"expires_at\" <= timestamptz '2027-01-14 00:00:00+00' AND \"evaluation_replay\".\"invocations\".\"pricing_verified_at\" <= \"evaluation_replay\".\"invocations\".\"issued_at\" AND \"evaluation_replay\".\"invocations\".\"admitted_at\" >= \"evaluation_replay\".\"invocations\".\"issued_at\" AND \"evaluation_replay\".\"invocations\".\"admitted_at\" < \"evaluation_replay\".\"invocations\".\"expires_at\" AND (\"evaluation_replay\".\"invocations\".\"started_at\" IS NULL OR (\"evaluation_replay\".\"invocations\".\"started_at\" >= \"evaluation_replay\".\"invocations\".\"admitted_at\" AND \"evaluation_replay\".\"invocations\".\"started_at\" < \"evaluation_replay\".\"invocations\".\"expires_at\")) AND (\"evaluation_replay\".\"invocations\".\"closed_at\" IS NULL OR \"evaluation_replay\".\"invocations\".\"closed_at\" >= \"evaluation_replay\".\"invocations\".\"admitted_at\")"
        },
