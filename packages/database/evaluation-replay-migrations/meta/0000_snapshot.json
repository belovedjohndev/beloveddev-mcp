          "name": "replay_invocation_limits",
          "value": "\"evaluation_replay\".\"invocations\".\"max_calls\" BETWEEN 1 AND 36 AND \"evaluation_replay\".\"invocations\".\"max_input_tokens_per_call\" BETWEEN 1 AND 1000000 AND \"evaluation_replay\".\"invocations\".\"max_output_tokens_per_call\" BETWEEN 16 AND 512 AND \"evaluation_replay\".\"invocations\".\"max_total_tokens\" BETWEEN 1 AND 4096 AND \"evaluation_replay\".\"invocations\".\"max_planned_cost_micro_usd\" BETWEEN 1 AND 1000000 AND \"evaluation_replay\".\"invocations\".\"max_calls\"::bigint * (\"evaluation_replay\".\"invocations\".\"max_input_tokens_per_call\" + \"evaluation_replay\".\"invocations\".\"max_output_tokens_per_call\") <= \"evaluation_replay\".\"invocations\".\"max_total_tokens\" AND \"evaluation_replay\".\"invocations\".\"last_turn_number\" BETWEEN 0 AND least(\"evaluation_replay\".\"invocations\".\"max_calls\", 6)"
        },
